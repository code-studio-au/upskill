APP_ENV=development
UPSKILL_LOG_LEVEL=info
APP_ORIGIN=http://localhost:3000
LEARNING_ORIGIN=http://localhost:3001
SUPPORT_EMAIL=support@upskill.example
DATABASE_URL=postgresql://upskill:upskill@localhost:5433/upskill
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional locally: ACCESS_CODE_ENCRYPTION_KEY must be a unique 32-byte base64url
# key. When omitted, local development derives one from BETTER_AUTH_SECRET.
SEED_LEARNER_PASSWORD=local-only-learner-password
STRIPE_SECRET_KEY=rk_test_replace
STRIPE_WEBHOOK_SECRET=whsec_replace
EMAIL_PROVIDER=local_capture
# To send real email locally, use EMAIL_PROVIDER=mailgun and configure:
# MAILGUN_API_KEY=replace-with-a-domain-sending-key
# MAILGUN_DOMAIN=mg.example.com
# MAILGUN_FROM=Upskill <no-reply@mg.example.com>
# MAILGUN_API_BASE_URL=https://api.mailgun.net
SMS_PROVIDER=local_capture
# To send real SMS locally, use SMS_PROVIDER=textbee and configure:
# TEXTBEE_API_KEY=replace-with-your-textbee-api-key
# TEXTBEE_API_BASE_URL=https://api.textbee.dev
# TEXTBEE_DEVICE_ID=optional-specific-device-id
# TEXTBEE_WEBHOOK_SECRET=replace-with-at-least-20-random-characters
LIVEKIT_ENABLED=false
LIVEKIT_PROJECT_ENVIRONMENT=development
# Populate these only when enabling the dormant LiveKit provider:
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=replace-with-livekit-api-key
# LIVEKIT_API_SECRET=replace-with-at-least-32-random-characters
# LIVEKIT_APPROVED_MAX_PARTICIPANTS=10
# LIVEKIT_APPROVED_MAX_CONCURRENT_ROOMS=1
# LIVEKIT_APPROVED_MAX_CONCURRENT_PARTICIPANTS=10
# LIVEKIT_APPROVED_MAX_CONCURRENT_EGRESS_JOBS=1
# LIVEKIT_APPROVED_MONTHLY_SPEND_AUD=100
# Optional until recording operations are activated. The configured role must
# permit only the dedicated recording bucket's recordings/ prefix.
# LIVEKIT_RECORDING_UPLOAD_ROLE_ARN=arn:aws:iam::123456789012:role/upskill-development-recording-upload
# LIVEKIT_RECORDING_ACCESS_GRANTS_ACCOUNT_ID=123456789012
OFFLINE_SCORM_ENABLED=false
# Populate these only when activating the complete offline Course path. The
# private key is a canonical base64url-encoded P-256 PKCS8 DER key.
# OFFLINE_SCORM_ENTITLEMENT_SIGNING_KEY_ID=offline-scorm-development-v1
# OFFLINE_SCORM_ENTITLEMENT_SIGNING_PRIVATE_KEY_PKCS8=replace-with-base64url-pkcs8
# The suffix must be operator-controlled and registered in the private section
# of the Public Suffix List. The origin key is canonical base64url for 32 bytes.
# OFFLINE_SCORM_PACKAGE_SITE_SUFFIX=offline.example.com
# OFFLINE_SCORM_PACKAGE_SITE_ORIGIN_KEY=replace-with-32-byte-base64url-key
AWS_REGION=ap-southeast-2
S3_ENDPOINT=http://127.0.0.1:9020
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_QUARANTINE_BUCKET=upskill-quarantine
S3_LEARNING_CONTENT_BUCKET=upskill-learning-content
S3_PRIVATE_RESOURCES_BUCKET=upskill-private-resources
S3_RECORDING_BUCKET=upskill-recordings
SQS_ENDPOINT=http://127.0.0.1:9324
SQS_QUEUE_URL=http://127.0.0.1:9324/000000000000/upskill-work
SQS_DEAD_LETTER_QUEUE_URL=http://127.0.0.1:9324/000000000000/upskill-work-dlq
SQS_RECEIVE_WAIT_SECONDS=20
SQS_VISIBILITY_TIMEOUT_SECONDS=900
