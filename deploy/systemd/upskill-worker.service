[Unit]
Description=Upskill asynchronous worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/upskill/current
EnvironmentFile=/opt/upskill/shared/upskill-worker.env
Environment=UPSKILL_PROCESS_ROLE=worker
StandardOutput=journal
StandardError=journal
SyslogIdentifier=upskill-worker
ExecStart=/usr/local/bin/node dist/worker/scorm-worker.js
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
