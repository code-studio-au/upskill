[Unit]
Description=Publish Upskill operational health metrics
After=network-online.target upskill-web.service upskill-worker.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/bin/upskill-publish-operational-metrics
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
