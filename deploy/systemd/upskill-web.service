[Unit]
Description=Upskill TanStack Start web service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
Group=ec2-user
WorkingDirectory=/opt/upskill/current
EnvironmentFile=/opt/upskill/shared/upskill.env
ExecStart=/usr/bin/node scripts/start-server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/upskill/shared

[Install]
WantedBy=multi-user.target
