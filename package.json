{
  "name": "upskill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=26 <27",
    "pnpm": "11.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate:routes": "tsr generate",
    "build": "vite build",
    "start": "node scripts/start-server.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify:dead-code": "knip",
    "verify:security:repo": "node scripts/verify-repo-security.mjs",
    "verify:cohorts": "node scripts/verify-dependency-cohorts.mjs",
    "verify:bundle": "node scripts/verify-client-bundle.mjs",
    "verify:app:static": "pnpm run verify:security:repo && pnpm run verify:cohorts && pnpm audit --audit-level high && pnpm run format:check && pnpm run lint",
    "verify:app:types": "pnpm run typecheck && pnpm run verify:dead-code",
    "verify:app:tests": "pnpm run coverage",
    "verify:app:build": "pnpm run build && pnpm run verify:bundle",
    "verify:app": "pnpm run verify:app:static && pnpm run verify:app:types && pnpm run verify:app:tests && pnpm run verify:app:build",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:verify:migrations": "tsx scripts/verify-migrations.ts",
    "db:generate-types": "kysely-codegen --dialect postgres --out-file src/server/db/generated.d.ts",
    "verify:db:gate": "pnpm run db:migrate && pnpm run db:verify:migrations",
    "verify:cdk": "pnpm --dir deploy/cdk run verify",
    "verify:ci": "pnpm run verify:app && pnpm run verify:cdk && pnpm run verify:db:gate"
  },
  "dependencies": {
    "@better-auth/stripe": "1.6.26",
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/client-sesv2": "3.1106.0",
    "@aws-sdk/client-sqs": "3.1106.0",
    "@aws-sdk/cloudfront-signer": "3.1098.0",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@mantine/notifications": "9.5.1",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-router": "1.170.23",
    "@tanstack/react-start": "1.168.40",
    "better-auth": "1.6.26",
    "kysely": "0.29.4",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tanstack/router-cli": "1.167.25",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "knip": "6.32.0",
    "kysely-codegen": "0.20.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.6",
    "tsx": "4.23.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
