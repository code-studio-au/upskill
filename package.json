{
  "name": "upskill",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=26 <27",
    "pnpm": "11.x"
  },
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "node scripts/start-development.mjs",
    "dev:web": "vite dev --port 3000",
    "dev:learning": "vite dev --port 3001",
    "generate:routes": "tsr generate",
    "build": "vite build && vite build --config vite.worker.config.ts",
    "start": "node scripts/start-server.mjs",
    "start:origins": "node scripts/start-local-origins.mjs",
    "test": "vitest run",
    "test:e2e": "pnpm run test:e2e:core && pnpm run test:e2e:scorm && pnpm run test:e2e:admin",
    "test:e2e:core": "playwright test --grep-invert='platform administrators can inspect learner progress|learners run SCORM inside the course workspace'",
    "test:e2e:scorm": "playwright test --project=chromium-mobile --grep='learners run SCORM inside the course workspace'",
    "test:e2e:admin": "playwright test --project=chromium-mobile --grep='platform administrators can inspect learner progress'",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "react-doctor . --yes --no-score --no-supply-chain --blocking error",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify:dead-code": "knip",
    "verify:security:repo": "node scripts/verify-repo-security.mjs",
    "verify:cohorts": "node scripts/verify-dependency-cohorts.mjs",
    "verify:bundle": "node scripts/verify-client-bundle.mjs",
    "verify:app:static": "pnpm run verify:security:repo && pnpm run verify:cohorts && pnpm audit --audit-level high && pnpm run format:check && pnpm run lint && pnpm run doctor",
    "verify:app:types": "pnpm run typecheck && pnpm run verify:dead-code",
    "verify:app:tests": "pnpm run coverage",
    "verify:app:build": "pnpm run build && pnpm run verify:bundle",
    "verify:app": "pnpm run verify:app:static && pnpm run verify:app:types && pnpm run verify:app:tests && pnpm run verify:app:build",
    "db:migrate": "node --env-file-if-exists=.env.local --import tsx src/server/db/migrate.ts",
    "db:seed:catalog": "node --env-file-if-exists=.env.local --import tsx scripts/seed-catalog.ts",
    "db:seed:learner": "node --env-file-if-exists=.env.local --import tsx scripts/seed-learner.ts",
    "db:verify:migrations": "node --env-file-if-exists=.env.local --import tsx scripts/verify-migrations.ts",
    "db:verify:audit": "node --env-file-if-exists=.env.local --import tsx scripts/verify-audit-logging.ts",
    "db:verify:access-codes": "node --env-file-if-exists=.env.local --import tsx scripts/verify-access-code-redemption.ts",
    "db:verify:checkout": "node --env-file-if-exists=.env.local --import tsx scripts/verify-course-checkout.ts",
    "db:verify:learner-workspace": "node --env-file-if-exists=.env.local --import tsx scripts/verify-learner-workspace.ts",
    "db:verify:scorm-attempts": "node --env-file-if-exists=.env.local --import tsx scripts/verify-scorm-attempts.ts",
    "db:verify:admin-visibility": "node --env-file-if-exists=.env.local --import tsx scripts/verify-admin-visibility.ts",
    "db:verify:admin-progress": "node --env-file-if-exists=.env.local --import tsx scripts/verify-admin-progress-overrides.ts",
    "db:verify:admin-enrollments": "node --env-file-if-exists=.env.local --import tsx scripts/verify-admin-enrollment-management.ts",
    "db:verify:admin-course-authoring": "node --env-file-if-exists=.env.local --import tsx scripts/verify-admin-course-authoring.ts",
    "db:verify:surveys": "node --env-file-if-exists=.env.local --import tsx scripts/verify-survey-workflow.ts",
    "db:verify:resources": "node --env-file-if-exists=.env.local --import tsx scripts/verify-resource-library.ts",
    "db:verify:certificates": "node --env-file-if-exists=.env.local --import tsx scripts/verify-completion-certificates.ts",
    "worker:scorm:once": "node --env-file-if-exists=.env.local --import tsx scripts/process-scorm-ingestion.ts",
    "worker:scorm": "node --env-file-if-exists=.env.local --import tsx src/worker/scorm-worker.ts",
    "verify:scorm-ingestion:local": "node --env-file-if-exists=.env.local --import tsx scripts/verify-scorm-package-ingestion.ts",
    "db:generate-types": "kysely-codegen --dialect postgres --out-file src/server/db/generated.d.ts",
    "verify:db:gate": "pnpm run db:migrate && pnpm run db:verify:migrations && pnpm run db:verify:audit && pnpm run db:verify:access-codes && pnpm run db:verify:checkout && pnpm run db:verify:learner-workspace && pnpm run db:verify:scorm-attempts && pnpm run db:verify:admin-visibility && pnpm run db:verify:admin-progress && pnpm run db:verify:admin-enrollments && pnpm run db:verify:admin-course-authoring && pnpm run db:verify:surveys && pnpm run db:verify:resources && pnpm run db:verify:certificates",
    "verify:cdk": "pnpm --dir deploy/cdk run verify",
    "verify:ci": "pnpm run verify:app && pnpm run verify:cdk && pnpm run verify:db:gate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1106.0",
    "@aws-sdk/client-sqs": "3.1106.0",
    "@better-auth/stripe": "1.6.26",
    "@mantine/core": "9.5.1",
    "@mantine/hooks": "9.5.1",
    "@tabler/icons-react": "3.46.0",
    "@tanstack/react-form": "1.20.0",
    "@tanstack/react-router": "1.170.23",
    "@tanstack/react-start": "1.168.40",
    "@zip.js/zip.js": "2.8.36",
    "better-auth": "1.6.26",
    "fast-xml-parser": "5.10.1",
    "fast-xml-validator": "1.4.1",
    "kysely": "0.29.4",
    "pdf-lib": "1.17.1",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "22.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tanstack/router-cli": "1.167.25",
    "@types/node": "26.2.0",
    "@types/pg": "8.21.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "10.8.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.9.0",
    "jsdom": "30.0.1",
    "knip": "6.32.0",
    "kysely-codegen": "0.20.0",
    "postcss-preset-mantine": "1.18.0",
    "postcss-simple-vars": "7.0.1",
    "prettier": "3.9.6",
    "react-doctor": "0.9.7",
    "tsx": "4.23.11",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.66.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "yaml": "2.9.0"
  }
}
